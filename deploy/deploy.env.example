# /etc/render-agent/deploy.env: settings for the boot-time bootstrap (placeholders only).
#
# install.sh copies this file to /etc/render-agent/deploy.env ONLY if that file does not exist yet.
# Everything here is optional; the defaults are what a normal instance wants. Values in the
# process environment win over this file.

# Run this exact release instead of the newest one (manual rollback). Remove it to follow the
# newest tag again.
# RENDER_AGENT_PIN=v0.0.0

# Where releases come from. The default is this project's public repository.
# RENDER_AGENT_REPO_URL=<repository-url>

# Where the bootstrap keeps releases and virtualenvs, and which Python builds the virtualenv.
# RENDER_AGENT_HOME=/opt/render-agent
# RENDER_AGENT_PYTHON=python3

# Where the chosen version is written for the agent (AGENT_VERSION=<tag>+<short sha>).
# RENDER_AGENT_VERSION_ENV=/run/render-agent/version.env

# Time budgets in seconds. After the total budget the bootstrap gives up on a new version and the
# agent starts on the one that already works.
# RENDER_AGENT_BOOTSTRAP_BUDGET_SECONDS=300
# RENDER_AGENT_FETCH_RETRY_SECONDS=120
# RENDER_AGENT_LOCK_WAIT_SECONDS=60
# RENDER_AGENT_GIT_TIMEOUT_SECONDS=120
# RENDER_AGENT_PIP_TIMEOUT_SECONDS=900
