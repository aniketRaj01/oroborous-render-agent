# /etc/render-agent/agent.env: settings for the render agent (placeholders only).
#
# install.sh copies this file to /etc/render-agent/agent.env ONLY if that file does not exist yet,
# owned by the service user with mode 0600. The agent refuses a config file that is readable by
# group or others, and systemd reads it as the EnvironmentFile, so keep the mode and the owner.
#
# The values below are deliberately invalid: until you replace them the agent stops at start-up
# with a message that names the setting. The Job API URL is NOT stored here; it lives in an SSM
# SecureString that the agent reads at start-up (see docs/instance-runbook.md).

# Stable identity of this instance. The Job API resumes jobs only for the same id, so use the EC2
# instance id and never change it.
AGENT_ID=<instance-id>

# Where the Job API URL (and nothing else sensitive) is read from at start-up.
RENDER_AGENT_SSM_PREFIX=<ssm-parameter-prefix>
RENDER_AGENT_SSM_REGION=<region>

# Optional overrides (see .env.example in the repository for the full list):
# JOB_API_REGION=<region>
# RUN_DEADLINE_MINUTES=55
# SCRATCH_DIR=/tmp/render-agent
