# /etc/render-agent/ltx-server.env: optional tuning for the model server (placeholders only).
#
# install.sh --ltx-root DIR creates this file from the example when it is missing. Everything is
# commented out: the defaults are what a normal instance wants. Change a value, then
#   sudo systemctl restart ltx-server
# See docs/model-server-runbook.md for how the measurement decides these.

# How a clip is rendered: pipeline (default, LTX as it ships, slow) or resident (every model built
# once and kept in memory). Switch only after the comparison test in docs/model-server-runbook.md.
# RENDER_MODE=pipeline
# Resident mode: move the transformer to host RAM before the video decode (1) or keep it on the GPU (0).
# PARK_TRANSFORMER_FOR_DECODE=1
# Pipeline mode: none (default, the known-good setting), cpu or disk. Do not use cpu with the registry.
# OFFLOAD_MODE=none
# Pipeline mode: cache checkpoint tensors in RAM (1) or not (0, default). 1 gave noise or out of memory.
# USE_REGISTRY=0
# Run the server from a git clone instead of the released code (for testing a branch).
# PYTHONPATH=<clone>/model_server
# Render one small clip at start-up so the first real clip is not slow (1) or skip it (0).
# WARMUP=1
# Restart the server after this many out-of-memory failures in a row.
# MAX_CONSECUTIVE_OOMS=2
# Longest clip accepted, in frames (8k+1).
# MAX_FRAMES=481
