# /etc/render-agent/ltx-server.env: optional tuning for the model server (placeholders only).
#
# install.sh --ltx-root DIR creates this file from the example when it is missing. Everything is
# commented out: the defaults are what a normal instance wants. Change a value, then
#   sudo systemctl restart ltx-server
# See docs/model-server-runbook.md for how the measurement decides these.

# Where the weights are kept while rendering: cpu (default), disk or none.
# OFFLOAD_MODE=cpu
# Cache checkpoint tensors in RAM in addition (1) or not (0).
# USE_REGISTRY=1
# Render one small clip at start-up so the first real clip is not slow (1) or skip it (0).
# WARMUP=1
# Restart the server after this many out-of-memory failures in a row.
# MAX_CONSECUTIVE_OOMS=2
# Longest clip accepted, in frames (8k+1).
# MAX_FRAMES=481
