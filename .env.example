# Names only, with fake placeholders. Copy to .env (gitignored) for local runs.
# Real values never go in this file. On the instance they come from SSM or /etc/render-agent/agent.env.
# Precedence, highest first: process environment, RENDER_AGENT_CONFIG_FILE, .env, SSM Parameter Store.

JOB_API_URL=https://example.invalid
AGENT_ID=changeme
# JOB_API_SIGNING=sigv4        # "none" is only accepted for a loopback JOB_API_URL
# JOB_API_REGION=us-east-1     # derived from a <id>.lambda-url.<region>.on.aws host when unset
# AGENT_VERSION=               # defaults to the installed package version

# JOB_API_TIMEOUT_SECONDS=35
# JOB_API_MAX_RETRIES=4
# JOB_API_RETRY_BASE_DELAY_SECONDS=0.5
# JOB_API_RETRY_MAX_DELAY_SECONDS=10
# JOB_API_RETRY_JITTER=0.5

# Run loop (all optional; defaults shown)
# MODEL_SERVER_URL=http://127.0.0.1:8000      # loopback only
# MODEL_SERVER_HEALTH_POLL_SECONDS=5
# MODEL_SERVER_READY_TIMEOUT_MINUTES=20
# MODEL_SERVER_GENERATE_TIMEOUT_SECONDS=1200
# SCRATCH_DIR=/tmp/render-agent                # absolute; created 0700
# MAX_PLANS_PER_CLAIM=10                       # 1 to 50
# EMPTY_CLAIM_WAIT_SECONDS=60
# IDLE_EXIT_MINUTES=5
# RUN_DEADLINE_MINUTES=55                      # from process start, at most 170
# CLIP_TIME_ESTIMATE_SECONDS=300               # until real timings exist
# MAX_CONSECUTIVE_FAILURES=3
# COMPLETE_RETRY_BUDGET_MINUTES=10

# Optional extra sources (read from the environment or .env):
# RENDER_AGENT_CONFIG_FILE=/etc/render-agent/agent.env
# RENDER_AGENT_SSM_PREFIX=/example/prefix
# RENDER_AGENT_SSM_REGION=us-east-1
